{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Digital subscription product offered in the Yovo store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "maxLength": 50 },
        "categoryId": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "duration": { "type": "string", "maxLength": 50 },
        "features": { "type": "array" },
        "available": { "type": "boolean" },
        "popular": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "guarantee": { "type": "string", "maxLength": 300 },
        "activationTime": { "type": "string", "maxLength": 100 },
        "plans": { "type": "array" },
        "purchaseCost": { "type": "number" },
        "adCost": { "type": "number" },
        "otherCosts": { "type": "number" },
        "targetMargin": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "currency", "duration", "available"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category grouping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 50 },
        "slug": { "type": "string", "maxLength": 50 },
        "available": { "type": "boolean" },
        "displayOrder": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record tracking status, costs, and profit",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "maxLength": 100 },
        "productName": { "type": "string", "maxLength": 100 },
        "planId": { "type": "string", "maxLength": 100 },
        "planName": { "type": "string", "maxLength": 100 },
        "sellingPrice": { "type": "number" },
        "productCost": { "type": "number" },
        "adCost": { "type": "number" },
        "paymentFee": { "type": "number" },
        "otherCosts": { "type": "number" },
        "totalCost": { "type": "number" },
        "profit": { "type": "number" },
        "customerInstagram": { "type": "string", "maxLength": 100 },
        "customerName": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "landingPageId": { "type": "string", "maxLength": 100 },
        "currency": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "cancelledAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "sellingPrice", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expense or direct cost entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "category": {
          "type": "string",
          "enum": ["product_purchase", "advertising", "payment_fees", "domain_hosting", "software", "other"]
        },
        "date": { "type": "string", "maxLength": 50 },
        "productId": { "type": "string", "maxLength": 100 },
        "campaignId": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["description", "amount", "category", "date"]
    },
    "AdCampaign": {
      "title": "AdCampaign",
      "description": "Advertising campaign spend and attribution record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "platform": {
          "type": "string",
          "enum": ["meta_ads", "tiktok_ads", "google_ads", "influencer", "other"]
        },
        "productId": { "type": "string", "maxLength": 100 },
        "amountSpent": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 50 },
        "endDate": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "platform", "amountSpent", "startDate"]
    },
    "LandingPage": {
      "title": "LandingPage",
      "description": "Custom high-converting dynamic subscription landing page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "productId": { "type": "string", "maxLength": 100 },
        "planId": { "type": "string", "maxLength": 100 },
        "heroTitle": { "type": "string", "maxLength": 200 },
        "heroDescription": { "type": "string", "maxLength": 500 },
        "badgeText": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "benefits": { "type": "array" },
        "features": { "type": "array" },
        "faq": { "type": "array" },
        "ctaText": { "type": "string", "maxLength": 100 },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "productId", "active"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store configuration and contact details",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 50 },
        "instagramUrl": { "type": "string", "maxLength": 200 },
        "whatsappUrl": { "type": "string", "maxLength": 200 },
        "whatsappDisplay": { "type": "string", "maxLength": 50 },
        "currency": { "type": "string", "maxLength": 10 },
        "footerText": { "type": "string", "maxLength": 300 },
        "guaranteeText": { "type": "string", "maxLength": 300 },
        "independentBrandNotice": { "type": "string", "maxLength": 500 }
      }
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Digital subscription product documents"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Categories for filtering and organizing products"
    },
    "/settings/{settingsId}": {
      "schema": "StoreSettings",
      "description": "Store level settings such as contact links, currency, notices"
    },
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized administrator users"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders initiated by customers and managed by store administrators"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business and product expenses managed by store administrators"
    },
    "/adCampaigns/{campaignId}": {
      "schema": "AdCampaign",
      "description": "Ad campaigns and marketing spend records"
    },
    "/landingPages/{landingPageId}": {
      "schema": "LandingPage",
      "description": "Public dynamic subscription landing pages configured by administrators"
    }
  }
}
