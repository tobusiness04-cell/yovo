rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Products: Public can read, Admins can write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(productId);
    }

    // Categories: Public can read, Admins can write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // Store Settings: Public can read, Admins can write
    match /settings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingsId);
    }

    // Admins registry: readable by signed-in users for self check, writable by Admins
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin() && isValidId(adminId);
    }
  }
}
