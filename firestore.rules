rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict Authorization: User must have an existing record in /admins/{uid}
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Products: Public can read, Admins can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: Public can read, Admins can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Store Settings: Public can read, Admins can write
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins registry:
    // Signed-in users can read their own admin doc;
    // Authorized admins can manage any admin doc;
    // Primary admin UID can initialize their record upon first setup.
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == adminId && request.auth.uid == 'YiiizflljtQElyHH0jICdy34drb2');
    }

    // Orders:
    // - Public visitors can create an order in 'pending' status
    // - Authenticated Admins can read, create, update, and delete any order
    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'pending' || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Expenses: Private store management data, strictly Admins only
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // Advertising Campaigns: Private store management data, strictly Admins only
    match /adCampaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // Landing Pages: Public can read published landing pages, Admins can write
    match /landingPages/{landingPageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

